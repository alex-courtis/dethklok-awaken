{
  "manifest_version": 3,
  "name": "Dethklok Awaken",
  "version": "1.3.0",
  "description": "Prevents display dimming and device sleep on ChromeOS while configured sites are open in a browser tab or PWA/app window, with a 60px orange-outlined Nathan Explosion squircle indicator when active.",
  "permissions": [
    "power",
    "tabs",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Dethklok Awaken",
    "default_icon": "icons/nathan-squircle-120.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "http://music.youtube.com/*",
        "https://www.youtube.com/*",
        "http://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/nathan-squircle-120.png"
      ],
      "matches": [
        "https://music.youtube.com/*",
        "http://music.youtube.com/*",
        "https://www.youtube.com/*",
        "http://www.youtube.com/*",
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
